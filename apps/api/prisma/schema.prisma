// Prisma schema for the public-notice-management API.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum UserStatus {
  active
  inactive
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  // Google account subject id ("sub" claim) — stable, unique per Google account.
  googleId    String     @unique @map("google_id")
  email       String     @unique
  name        String
  avatarUrl   String?    @map("avatar_url")
  role        Role       @default(user)
  status      UserStatus @default(active)
  lastLoginAt DateTime?  @map("last_login_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // WhatsApp alert channel — a verified number opts a user into WhatsApp
  // delivery for their AlertRules. The otp/pending fields hold a single
  // in-flight verification attempt (one at a time per user).
  whatsappNumber         String?   @map("whatsapp_number")
  whatsappVerified       Boolean   @default(false) @map("whatsapp_verified")
  whatsappAlertsEnabled  Boolean   @default(false) @map("whatsapp_alerts_enabled")
  whatsappPendingNumber  String?   @map("whatsapp_pending_number")
  whatsappOtpCode        String?   @map("whatsapp_otp_code")
  whatsappOtpExpiresAt   DateTime? @map("whatsapp_otp_expires_at")
  whatsappOtpRequestedAt DateTime? @map("whatsapp_otp_requested_at")
  // Email alert channel — delivered to the account email, so nothing to
  // verify. On by default: it costs nothing and it's the only channel a user
  // has before they connect WhatsApp. Still requires the admin to have
  // configured + enabled SMTP (see EmailChannelService).
  emailAlertsEnabled     Boolean   @default(true) @map("email_alerts_enabled")
  // Delivery cadence for matched alerts: instant (one message per match) or
  // a batched digest. HIGH-priority AlertRules always bypass this and send
  // instantly regardless (see AlertMatchingService).
  digestFrequency  DigestFrequency @default(INSTANT) @map("digest_frequency")
  lastDigestSentAt DateTime?       @map("last_digest_sent_at")

  documents         Document[]
  alertRules        AlertRule[]
  alertNotifications AlertNotification[]

  // Membership. A user with no row is treated as FREE (see PlansService), so
  // signup needs no billing write and existing accounts keep working.
  subscription   Subscription?
  usageCounters  UsageCounter[]
  usageEvents    UsageEvent[]

  @@map("users")
}

enum AlertPriority {
  NORMAL
  HIGH
}

enum AlertUrgency {
  LOW
  MEDIUM
  HIGH
}

enum DigestFrequency {
  INSTANT
  DAILY
  WEEKLY
}

// A user-defined rule matched against newly scraped notices. Categories and
// tags are the required primary basis for a rule — at least one of the two
// must be set (see AlertsService.assertHasPrimaryDimension). Every other
// dimension (keywords, excludeKeywords, organizations, minUrgency,
// deadlineWithinDays) is an optional refinement layered on top; none of them
// may be used as the sole basis of a rule. Every non-empty dimension is
// AND'd together; values within a single dimension (e.g. multiple keywords)
// are OR'd. Matches for users with whatsappAlertsEnabled trigger a WhatsApp
// message, instantly or batched into a digest depending on
// User.digestFrequency (see AlertMatchingService / AlertDigestService).
model AlertRule {
  id       String        @id @default(uuid()) @db.Uuid
  userId   String        @map("user_id") @db.Uuid
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  enabled  Boolean       @default(true)
  // HIGH bypasses the user's digest setting and always sends instantly —
  // for rules the user considers time-sensitive (e.g. deadline alerts).
  priority AlertPriority @default(NORMAL)

  // Primary basis (required — at least one of the two): notice's category
  // must be one of these, and/or notice's AI-assigned tags must include at
  // least one of these.
  categories ScrapedItemCategory[] @default([])
  tags       String[]              @default([])

  // Optional refinements — layered on top of category/tags, never usable alone.
  // Include: notice must contain at least one of these (title/summary/content).
  keywords        String[] @default([])
  // Exclude: if the notice contains ANY of these, the rule never fires,
  // even if every other dimension matches.
  excludeKeywords String[] @default([]) @map("exclude_keywords")
  // Notice's organization/source must contain at least one of these.
  organizations   String[] @default([])
  // Notice's AI-assessed urgency must be at or above this level.
  minUrgency      AlertUrgency? @map("min_urgency")
  // Notice must have an extracted deadline within this many days from now.
  deadlineWithinDays Int? @map("deadline_within_days")

  matchCount Int      @default(0) @map("match_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  notifications AlertNotification[]

  @@index([userId])
  @@map("alert_rules")
}

enum AlertNotificationStatus {
  PENDING
  SENT
  FAILED
  // Matched and recorded, but no outbound channel was available or allowed
  // (no WhatsApp connected, SMTP off, monthly allowance spent). Not an error
  // — the match is still real and still shows in the in-app feed.
  SKIPPED
}

// One (user, scrapedItem) delivery record — the unique constraint is what
// prevents a user being messaged twice for the same notice even if several
// of their rules match it. A row is written for every match, whether or not
// anything was delivered, so it doubles as the in-app alert feed.
model AlertNotification {
  id            String                   @id @default(uuid()) @db.Uuid
  userId        String                   @map("user_id") @db.Uuid
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertRuleId   String                   @map("alert_rule_id") @db.Uuid
  alertRule     AlertRule                @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  scrapedItemId String                   @map("scraped_item_id") @db.Uuid
  scrapedItem   ScrapedItem              @relation(fields: [scrapedItemId], references: [id], onDelete: Cascade)
  status        AlertNotificationStatus
  // Channels that actually accepted the message, e.g. ["whatsapp","email"].
  channels      String[]                 @default([])
  error         String?
  // Null until the user opens the in-app alert feed — drives the bell badge.
  readAt        DateTime?                @map("read_at")
  sentAt        DateTime                 @default(now()) @map("sent_at")

  @@unique([userId, scrapedItemId])
  @@index([alertRuleId])
  @@index([userId, status])
  @@index([userId, sentAt])
  @@map("alert_notifications")
}

enum DocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  UNEMBEDDED
  FAILED
}

model Document {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  filename    String
  mimeType    String         @map("mime_type")
  fileSize    Int            @map("file_size")
  // S3 object key (e.g. "documents/<uuid>.pdf") — despite the mapped column
  // name, this has not held a local filesystem path since the S3 migration.
  storageKey  String         @map("file_path")
  fileHash    String?        @unique @map("file_hash")  // SHA-256 for deduplication
  status      DocumentStatus @default(PENDING)
  isOcr       Boolean        @default(false) @map("is_ocr")
  isSystem    Boolean        @default(false) @map("is_system")
  textLength  Int?           @map("text_length")
  chunkCount  Int?           @map("chunk_count")
  uploadedBy  String?        @map("uploaded_by") @db.Uuid
  user        User?          @relation(fields: [uploadedBy], references: [id])
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  indexedAt   DateTime?      @map("indexed_at")

  @@map("documents")
}

enum ScrapedItemCategory {
  NOTICE
  NEWS
  PRESS_RELEASE
  CIRCULAR
  TENDER
  VACANCY
  JOB
  INTERNSHIP
  OTHER
}

enum ScrapeRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum ScrapePaginationType {
  QUERY_PARAM    // append ?<paginationParam>=<n> (or & if the URL already has a query string)
  PATH_TEMPLATE  // substitute a literal "{page}" token anywhere in the listing URL
  NONE           // single page only, regardless of maxPages
}

// An admin-configured website to scrape for notices/news. CSS extraction
// schemas are auto-detected (heuristics, with an LLM fallback) on first run
// and cached here so subsequent runs are pure, fast CSS parsing.
model ScrapeSource {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  baseUrl           String    @map("base_url")
  // Listing page URLs; at least one must be set.
  noticeListUrl         String?   @map("notice_list_url")
  newsListUrl           String?   @map("news_list_url")
  pressReleaseListUrl   String?   @map("press_release_list_url")
  // Cached JsonCssExtractionStrategy schemas (crawl4ai format), keyed implicitly
  // by category via these columns. Null until the first successful run.
  noticeSchema          Json?     @map("notice_schema")
  newsSchema            Json?     @map("news_schema")
  pressReleaseSchema    Json?     @map("press_release_schema")
  // Pagination behavior — sites vary wildly (?page=N, ?start=N, /page/N/, or
  // no pagination at all), so this is admin-configurable per source rather
  // than assumed.
  paginationType    ScrapePaginationType @default(QUERY_PARAM) @map("pagination_type")
  paginationParam   String    @default("page") @map("pagination_param")
  startPage         Int       @default(1) @map("start_page")
  maxPages          Int       @default(3) @map("max_pages")
  // How often the automatic scheduler probes this source. HTML-only sources
  // need a full crawl per poll, so they default to a slow 15-min cadence;
  // sources with a usable sitemap fast-path can poll much more aggressively
  // (3 min or less). Admin-editable per source because posting frequency
  // varies wildly across ministries.
  pollIntervalSeconds Int @default(900) @map("poll_interval_seconds")
  // Cached sitemap URL for the cheap "new URLs only" fast-path. Null means
  // "no usable sitemap — HTML-poll only". Detection is attempted exactly once
  // (see sitemapCheckedAt) and the winner cached here, mirroring how
  // noticeSchema/newsSchema cache CSS extraction patterns.
  sitemapUrl         String?   @map("sitemap_url")
  // When sitemap detection was last attempted. Non-null means "tried once,
  // don't re-detect every tick" (null result is cached as a null sitemapUrl).
  sitemapCheckedAt   DateTime? @map("sitemap_checked_at")
  // True for sources auto-created by the admin "paste a link" quick-scrape
  // flow (no listing URLs, nothing to schedule). Kept enabled so
  // runSourceFromUrls's guard passes, but excluded from the scheduler's
  // due-source query — see ScrapingSchedulerService.findDueSources.
  isAdHoc           Boolean   @default(false) @map("is_ad_hoc")
  enabled           Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  lastRunAt         DateTime? @map("last_run_at")
  lastStatus        ScrapeRunStatus? @map("last_status")
  // Denormalized copy of the most recent run's error/failedUrls so the admin
  // source card can show "why it failed" without a second query per card.
  // Cleared (set null) whenever a run finishes with no failures.
  lastError         String?   @map("last_error")
  lastFailedUrls    Json?     @map("last_failed_urls")
  // Actionable explanation of the most recent failed/empty run, produced by
  // the AI service's diagnosis rules:
  // [{ code, severity, title, detail, fix, patch, actions, urls }]. `patch`
  // is a partial update to this row the admin can apply in one click, so a
  // moved listing URL or a wrong pagination param is a button, not a
  // debugging session. Cleared when a run succeeds with items.
  lastDiagnosis     Json?     @map("last_diagnosis")
  lastDiagnosedAt   DateTime? @map("last_diagnosed_at")

  items ScrapedItem[]
  runs  ScrapeRun[]

  @@map("scrape_sources")
}

// A single notice or news item scraped from a government portal.
model ScrapedItem {
  id            String              @id @default(uuid()) @db.Uuid
  sourceId      String?             @map("source_id") @db.Uuid
  source        ScrapeSource?       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceLabel   String              @default("mofa.gov.np") @map("source_label")
  category      ScrapedItemCategory
  // Raw URL slug segment from which the category was inferred (e.g. "press-release").
  sourceSlug    String?             @map("source_slug")
  title         String
  // Canonical absolute URL of the detail page — used as the dedup key across scrape runs.
  sourceUrl     String              @unique @map("source_url")
  summary       String?
  contentText   String?             @map("content_text")
  contentHtml   String?             @map("content_html")
  attachmentUrl String?             @map("attachment_url")
  publishedAt   DateTime?           @map("published_at")
  /// Read-only. A Postgres STORED generated column, COALESCE(publishedAt,
  /// scrapedAt) — the single key every "latest" ordering sorts on. Never write
  /// to it: the database maintains it, and an INSERT that names it will fail.
  effectivePublishedAt DateTime?    @map("effective_published_at")
  contentHash   String              @map("content_hash")
  views         Int                 @default(0)
  // AI enrichment — computed concurrently during scraping, not lazily.
  aiSummary     String?             @map("ai_summary")
  aiSummaryNe   String?             @map("ai_summary_ne")
  aiUrgency     String?             @map("ai_urgency")
  aiCategoryConfidence Float?       @map("ai_category_confidence")
  keyFacts      Json?               @map("key_facts")
  tags          Json?
  // Structured metadata: reference number, issuing office, deadline, etc.
  metadata      Json?
  aiAnalyzedAt  DateTime?           @map("ai_analyzed_at")
  scrapedAt     DateTime            @default(now()) @map("scraped_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  attachments   Attachment[]
  noticeViews   NoticeView[]
  alertNotifications AlertNotification[]

  @@index([category])
  @@index([publishedAt])
  @@index([sourceId])
  @@index([category, publishedAt])
  @@index([sourceId, publishedAt])
  @@map("scraped_items")
}

model Attachment {
  id            String    @id @default(uuid()) @db.Uuid
  itemId        String    @map("item_id") @db.Uuid
  item          ScrapedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url           String
  mimeType      String?   @map("mime_type")
  sizeBytes     Int?      @map("size_bytes")
  storageKey    String?   @map("storage_key")
  downloadedAt  DateTime? @map("downloaded_at")
  label         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([itemId])
  @@map("attachments")
}

// One execution of a scraping job, for the admin dashboard's logs view.
model ScrapeRun {
  id               String          @id @default(uuid()) @db.Uuid
  sourceId         String?         @map("source_id") @db.Uuid
  source           ScrapeSource?   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceLabel      String          @default("mofa.gov.np") @map("source_label")
  status           ScrapeRunStatus @default(RUNNING)
  itemsFound       Int             @default(0) @map("items_found")
  itemsNew         Int             @default(0) @map("items_new")
  itemsUpdated     Int             @default(0) @map("items_updated")
  itemsSkipped     Int             @default(0) @map("items_skipped")
  itemsSummarized  Int             @default(0) @map("items_summarized")
  itemsSummaryFailed Int           @default(0) @map("items_summary_failed")
  error            String?
  // Structured per-page/per-URL failures for this run:
  // [{ url, stage: "schema_detection"|"listing"|"detail"|"raw_fetch", error }].
  // Populated even on an otherwise-SUCCESS run (partial failures), so the
  // admin can see exactly which page failed and why, not just an aggregate
  // one-line message.
  failedUrls       Json?           @map("failed_urls")
  // Same shape as ScrapeSource.lastDiagnosis, kept per-run so the Logs view
  // can explain a historical failure and not just the latest one.
  diagnosis        Json?
  startedAt        DateTime        @default(now()) @map("started_at")
  finishedAt       DateTime?       @map("finished_at")

  @@index([sourceId])
  @@map("scrape_runs")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  email     String
  subject   String
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  ip        String?              @map("ip")
  userAgent String?              @map("user_agent") @db.Text
  // honeypot field trap - if filled, it's spam and we store it flagged
  // (we still record but mark as archived)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("contact_messages")
}

// Which request/response shape a provider speaks. Most vendors (Groq,
// OpenRouter, Together, DeepSeek, Fireworks, vLLM, Ollama) expose the OpenAI
// chat-completions schema, so one adapter covers nearly everything; Gemini's
// generateContent API is different enough to need its own.
enum AiProviderKind {
  OPENAI_COMPATIBLE
  GEMINI
  BEDROCK
}

/**
 * An LLM provider the AI service may call, in admin-controlled priority order.
 *
 * Replaces the previously hardcoded provider list: built-in providers are
 * seeded rows (isBuiltIn = true) and behave identically to admin-added ones,
 * so "add a provider" is a first-class operation rather than a special case.
 * `sortOrder` IS the fallback chain — the first enabled provider that answers
 * wins. The AI service pulls this list (with decrypted keys) over the
 * internal service-to-service endpoint.
 */
model AiProvider {
  id        String         @id @default(uuid()) @db.Uuid
  // Stable identifier used in logs and by the AI service; immutable for
  // built-ins so ordering/health keep lining up across restarts.
  slug      String         @unique
  label     String
  kind      AiProviderKind
  // Full chat-completions endpoint for OPENAI_COMPATIBLE providers. Null for
  // GEMINI, whose URL is derived from the model name, and for BEDROCK, which
  // is addressed by region instead.
  baseUrl   String?        @map("base_url")
  // AWS region for BEDROCK providers (e.g. us-west-2); null for every other
  // kind. Required there because the Bedrock endpoint is region-addressed.
  region    String?
  model     String
  // AES-256-GCM ciphertext (SecretCryptoService) — never a plaintext key.
  // Null means "fall back to the AI service's own environment variable".
  apiKeyEnc String?        @map("api_key_enc")
  enabled   Boolean        @default(true)
  sortOrder Int            @map("sort_order")
  isBuiltIn Boolean        @default(false) @map("is_built_in")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("ai_providers")
}

// ---------------------------------------------------------------------------
// Membership & billing
//
// Three tiers (FREE / PRO / MAX) whose *definitions* live in the database, not
// in code, so an admin can retune prices, limits and marketing copy without a
// deploy. Stripe holds the payment catalogue; `stripePriceId` is the join
// between a row here and a recurring Price over there.
// ---------------------------------------------------------------------------

enum PlanTier {
  FREE
  PRO
  MAX
}

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  tier        PlanTier @unique
  name        String
  tagline     String?
  description String?

  // Pricing. Cents avoids float drift; `interval` is informational because
  // Stripe's Price is the source of truth for what actually gets charged.
  priceMonthlyCents Int     @default(0) @map("price_monthly_cents")
  priceYearlyCents  Int?    @map("price_yearly_cents")
  currency          String  @default("usd")

  // Stripe catalogue links. Null on FREE (nothing to charge for).
  stripeProductId        String? @map("stripe_product_id")
  stripePriceId          String? @map("stripe_price_id")
  stripeYearlyPriceId    String? @map("stripe_yearly_price_id")

  // ---- Limits. NULL means unlimited; 0 means the feature is unavailable. ----
  // Embedded documents a user may keep at once (storage + embedding cost).
  maxDocuments           Int?    @map("max_documents")
  // AI questions per calendar month, across RAG chat and per-notice Q&A.
  maxAiQuestionsPerMonth Int?    @map("max_ai_questions_per_month")
  // Saved alert rules.
  maxAlertRules          Int?    @map("max_alert_rules")
  // WhatsApp alert deliveries per calendar month (real per-message cost).
  maxWhatsappPerMonth    Int?    @map("max_whatsapp_per_month")
  // Largest single upload, in megabytes.
  maxUploadMb            Int     @default(5) @map("max_upload_mb")
  // Instant alert delivery; when false the user is held to digest cadence.
  allowInstantAlerts     Boolean @default(false) @map("allow_instant_alerts")

  // Marketing bullets rendered on the pricing page, in order.
  features  Json?
  // Hidden plans still work for existing subscribers but aren't sold.
  isPublic  Boolean @default(true) @map("is_public")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String @map("plan_id") @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(ACTIVE)

  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")

  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at")

  // Set when an admin grants a plan by hand; such a subscription is never
  // downgraded by Stripe webhooks.
  grantedByAdmin Boolean @default(false) @map("granted_by_admin")
  grantNote      String? @map("grant_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

enum UsageMetric {
  AI_QUESTION
  DOCUMENT_UPLOAD
  WHATSAPP_NOTIFICATION
  ALERT_RULE
}

// Fast path for quota checks: one row per user/metric/month.
model UsageCounter {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric      UsageMetric
  // First instant of the UTC month this counter covers.
  periodStart DateTime    @map("period_start")
  count       Int         @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, metric, periodStart])
  @@index([periodStart])
  @@map("usage_counters")
}

// Append-only detail behind the counters, for the admin's per-user drill-down.
// Pruned on a schedule so it can't grow without bound.
model UsageEvent {
  id       String      @id @default(uuid()) @db.Uuid
  userId   String      @map("user_id") @db.Uuid
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric   UsageMetric
  quantity Int         @default(1)
  // Free-form context: which document, which notice, which alert rule.
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([metric, createdAt])
  @@map("usage_events")
}

// Revoked JWT hashes — DB-backed for cross-restart / multi-replica safety.
// See TokenRevocationService.
model RevokedToken {
  tokenHash String   @id @map("token_hash")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("revoked_tokens")
}

// Free chatbot allowance for signed-out visitors, counted per client per UTC
// day. In the database rather than in memory so the allowance survives a
// deploy and holds across API replicas — an in-process counter would reset
// on every restart, which is the same as having no limit.
//
// `clientHash` is a salted SHA-256 of the caller's IP: the raw address is
// never stored, and a counter never needs to be reversed to a person.
// One row per (viewer, notice, UTC day) — the dedupe key behind ScrapedItem.views.
//
// The counter alone cannot be deduped correctly: the previous throttle was
// keyed by notice id only, so a hundred people opening the same notice inside
// the window counted as one view. Popularity actively suppressed the count.
//
// `viewerHash` is a salted SHA-256 of IP + user-agent; the raw address is never
// stored. Rows are only ever inserted, and are prunable by `day`.
model NoticeView {
  noticeId   String      @map("notice_id") @db.Uuid
  notice     ScrapedItem @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  viewerHash String      @map("viewer_hash")
  day        DateTime    @map("day") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  @@id([noticeId, viewerHash, day])
  @@index([day])
  @@map("notice_views")
}

model AnonAiUsage {
  clientHash String   @map("client_hash")
  // Midnight UTC of the day this counter covers.
  day        DateTime @map("day") @db.Date
  count      Int      @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([clientHash, day])
  // Pruning old days scans on this.
  @@index([day])
  @@map("anon_ai_usage")
}
