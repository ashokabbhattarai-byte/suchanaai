# ── API service environment ───────────────────────────
# Copy to .env and fill in real values

PORT=5005
NODE_ENV=development

# ── Observability ────────────────────────────────────
# Structured JSON logger level: verbose | debug | info | log | warn | error | fatal
LOG_LEVEL=info
# "json" (default) — one JSON object per line, ready for CloudWatch/Loki/Datadog.
# Set to "pretty" for colored human-readable output during local development.
LOG_FORMAT=json
# Log every Prisma query (and slow queries >= DB_SLOW_QUERY_MS) — mostly for dev.
DB_LOG_QUERIES=false
# Queries slower than this (ms) are logged as warnings. 0 disables slow-query logging.
DB_SLOW_QUERY_MS=500

# Database
# Point this at your Postgres instance (dev, staging or prod).
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/public_notice_management
# Prisma connection pool size and wait timeout. Tune to your DB's max_connections.
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT_MS=20000

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Google OAuth — from Google Cloud Console (OAuth 2.0 Client ID, type "Web application").
# The web app must use this SAME client id as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated allowlist of emails granted the "admin" role on login.
ADMIN_EMAILS=ashok.ab.bhattaraii@gmail.com

# Allowed browser origin(s) for CORS (comma-separated). The production domains
# (https://suchanaai.tech, https://www.suchanaai.tech) are always allowed in code.
WEB_ORIGIN=http://localhost:3535

# Public site URL used inside WhatsApp alert message links (notice + manage-alerts
# links). Always the real public domain, never WEB_ORIGIN/localhost — WhatsApp
# won't render localhost links as tappable, and a recipient's phone can't reach it.
PUBLIC_SITE_URL=https://suchanaai.tech

# AI service
AI_SERVICE_URL=http://localhost:8000
# Max time to wait for the AI service to index one document (OCR + embedding).
AI_INDEX_TIMEOUT_MS=600000

# ── File storage (S3) ──────────────────────────────────
# Every uploaded RAG document and every cached scraped-notice attachment
# lives in this one private S3 bucket — nothing is ever written to local
# disk (see src/common/storage/s3-storage.service.ts). The bucket blocks all
# public access; files are only ever reached via short-lived presigned URLs
# generated on request (GET /documents/:id/download,
# GET /attachments/:id/file).
S3_BUCKET_NAME=your-bucket-name
AWS_REGION=us-east-1
# Only needed on hosts with no attached AWS IAM role (e.g. a self-hosted
# Oracle/EC2 box running docker-compose). On AWS compute with an instance
# role already scoped to this bucket (Elastic Beanstalk/ECS/EC2), leave both
# unset — the AWS SDK's default credential chain picks up the role
# automatically and these are never read.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# WhatsApp webhook — Evolution API (Evolution instance URL + API key).
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=PublicNoticeManagement

# ── Email alert channel (SMTP) ────────────────────────
# Host/port/username/password are NOT set here — an admin enters them at
# /admin/alerts and they are stored in app_settings with the password
# encrypted under SETTINGS_ENCRYPTION_KEY. These two knobs only widen the
# guard rails that constrain what an admin may point the server at.
#
# Ports an admin may choose. Anything outside this list is rejected, so the
# form can't be used to open connections to arbitrary internal services.
SMTP_ALLOWED_PORTS=25,465,587,2525
# Leave false in production. When false, an SMTP host that resolves to a
# loopback/private/link-local address is refused (SSRF + metadata-endpoint
# protection). Set true only for local development against MailHog/Mailpit.
SMTP_ALLOW_PRIVATE_HOSTS=false

# Scraping
# Max concurrent full crawls (cheap sitemap checks are NOT counted against this).
SCRAPING_CONCURRENCY=3
# Automatic polling cron — default: once a minute, at second 0.
SCRAPING_INTERVAL_CRON=0 * * * * *
# A RUNNING scrape older than this (seconds) is considered abandoned and is
# reclaimed as FAILED so the source becomes pollable again.
SCRAPING_STALE_TIMEOUT_SECONDS=3600
# Politeness floor for per-source poll intervals — nothing below this, even
# for sitemap-only checks.
SCRAPING_MIN_POLL_INTERVAL_SECONDS=60
# A source that keeps failing backs off exponentially (its interval doubles per
# consecutive failure) up to this ceiling, instead of retrying forever.
SCRAPING_MAX_BACKOFF_SECONDS=21600
# How far back consecutive failures are counted when sizing that backoff, so a
# source broken by an outage on our side recovers once the outage passes.
SCRAPING_FAILURE_WINDOW_SECONDS=7200

# ── Read-path caching ─────────────────────────────────
# TTL (ms) for the public notices list (page load spikes). 0 disables caching.
NOTICES_LIST_CACHE_MS=10000
# TTL (ms) for meta endpoints (category counts, source dropdowns).
NOTICES_META_CACHE_MS=60000

# ── Membership & billing (Stripe) ─────────────────────
# Secret key for the Stripe REST API (checkout sessions, billing portal, sub lookups).
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Signing secret for the /webhooks/stripe endpoint — from the Stripe Dashboard
# (or `stripe listen --print-secret` for local testing).
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
# Base URL of the web app, used to build Stripe checkout success/cancel and
# billing-portal return URLs. Should match WEB_ORIGIN in production.
APP_URL=http://localhost:3535

# ── Admin-managed settings encryption ─────────────────
# 32-byte key (base64), used to encrypt `secret`-type admin settings at rest
# (AI provider API keys managed from /admin/settings) — AES-256-GCM via
# apps/api/src/services/settings.service.ts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/rotating this key makes every previously-saved secret setting
# undecryptable — back it up like any other production credential.
SETTINGS_ENCRYPTION_KEY=

# Shared secret for service-to-service calls FROM apps/ai TO this API (only
# consumer today: GET /internal/ai-config, which apps/ai polls to pick up
# admin-configured LLM API keys/models without a redeploy). Not a user JWT —
# the caller has no user identity. Must match apps/ai's INTERNAL_SERVICE_SECRET
# exactly. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_SERVICE_SECRET=

# ── Contact form — Google reCAPTCHA v2 checkbox ─────────
# Get keys at https://www.google.com/recaptcha/admin#list (type: reCAPTCHA v2 → "I'm not a robot" Checkbox)
# Secret stays server-only; site key goes to the web app as NEXT_PUBLIC_RECAPTCHA_SITE_KEY.
# Test keys that always pass (useful for local dev / automated tests):
#   Site: 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   Secret: 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# Leave empty to disable verification locally (honeypot + rate limits still apply). Always set in production.
RECAPTCHA_SECRET_KEY=
# Optional: comma-separated hostnames allowed to pass captcha (empty = any hostname accepted)
RECAPTCHA_ALLOWED_HOSTNAMES=

# ── AI provider allowlist (SSRF guard bypass) ───────
# Comma-separated hosts allowed to use plain-http or private IPs.
# Needed for self-hosted Ollama/vLLM on EC2 (t3.large i-071d7b2debed5e3ed, private 172.31.95.204, public 3.80.188.210).
# Example: Ollama at 3.80.188.210:11434 (private 172.31.95.204:11434) qwen2.5:1.5b 986MB ~2-4s TOP -10,
#          vLLM   at 3.80.188.210:8001  (private 172.31.95.204:8001)  Qwen2.5-1.5B ~3-7s SECOND -9.
# Without this, assertSafeEndpoint rejects http and private addresses.
# FIX 2026-09-08: vLLM 8001 is DOWN — "Could not reach provider. All connection attempts failed"
#  (Failed to infer device type + vllm._C_AVX512 missing on CPU-only t3.large, /opt/vllm Python 3.11).
#  Ollama 11434 is Responding 2127ms ✓ TOP -10 (proven CPU via llama.cpp). vLLM is now SECOND -9
#  (GPU-optimized, slower on CPU, needs VLLM_TARGET_DEVICE=cpu SOURCE build, 30-60 min, no prebuilt wheels).
#  See scripts/ec2-install-vllm.sh FIX OPTIONS, docs/EC2_VLLM_MIGRATION.md Troubleshooting,
#  and apps/api/src/services/ai-providers.service.ts (auto-swaps DB on boot: Ollama -10, vLLM -9).
# AI_PROVIDER_ALLOWED_HOSTS=3.80.188.210
# (host only — covers both :11434 and :8001; add more hosts comma-separated if you have other self-hosted boxes)

# ── AI enrichment guards ──────────────────────────────
# Cooldown (ms) after a failed view-triggered AI call (PDF OCR, summarization)
# before the same notice is retried. Prevents a flaky AI service from being
# pounded by every viewer at once. Concurrent viewers already share one
# in-flight call (single-flight), regardless of this value.
AI_RETRY_COOLDOWN_MS=60000
# TTL (ms) for memoized LLM answers: identical notice Q&A questions and
# identical chatbot search queries share the LLM call within this window.
QA_CACHE_MS=300000

# Free chatbot questions a signed-out visitor gets per UTC day, across both the
# floating chat and per-notice Q&A. Signed-in users are metered by their plan
# instead (see PlansService). 0 shuts the assistant to anonymous visitors
# entirely; the counter resets at midnight UTC.
ANON_AI_QUESTIONS_PER_DAY=5
# Salt for the stored hash of a visitor's IP. Falls back to JWT_SECRET when
# unset. Changing it resets every anonymous counter.
ANON_QUOTA_SALT=
