PORT=8000
ENVIRONMENT=development
# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Log output format: "json" (default, one JSON record per line — ship to
# CloudWatch/Loki/Datadog) or "pretty" (human-readable for local dev).
LOG_FORMAT=json
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Must match EMBEDDING_MODEL's output dimension and the Qdrant collection size.
EMBEDDING_DIM=768
# Optional HuggingFace read token (https://huggingface.co/settings/tokens).
# EMBEDDING_MODEL is public, so anonymous downloads work — this only lifts the
# per-IP rate limit that makes the first cold-cache boot slow.
HF_TOKEN=
# Hybrid retrieval (dense + BM25 fused with RRF). Set false for dense-only.
HYBRID_SEARCH=true
SPARSE_MODEL=Qdrant/bm25
QDRANT_URL=http://localhost:6333
# Leave empty if your Qdrant instance has no API key configured.
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Chunks embedded per batch; lower this on memory-constrained machines.
EMBEDDING_BATCH_SIZE=32
# Retrieval hits scoring below this cosine similarity are dropped from context.
# Note: E5 models compress scores into ~0.7-0.9, so this is not a typical 0-1 value.
RAG_SCORE_THRESHOLD=0.78
# Same, for the notice chatbot (/notices/search). Separate from the document
# threshold above because its questions are often cross-lingual — an English
# question against a Nepali notice scores a little lower even when it is an
# exact topical match. Lower it if the assistant says "nothing found" for
# questions that do have matching notices; raise it if answers cite notices
# that are merely adjacent to the question.
NOTICE_SCORE_THRESHOLD=0.78
# Hits more than this far below the best hit are dropped even when above the
# floor, so one strong match isn't diluted by a long tail of weak ones.
NOTICE_SCORE_MARGIN=0.06

# ── Sampling temperature, per task ────────────────────
# Fallback defaults only. The admin panel (/admin/ai → Temperature) is the
# real control: its values arrive on the config poll and override these at
# runtime, so editing them here only matters before the first successful sync.
# Extraction calls (classification, notice-analysis JSON, scraper schema
# detection) are pinned at 0.0 in code and are deliberately not tunable —
# sampling there yields malformed JSON and mis-categorised notices.
TEMPERATURE_ANSWERS=0.4
TEMPERATURE_SUMMARIES=0.2
TEMPERATURE_CONVERSATION=0.9
# ── Admin-managed AI config sync ──────────────────────
# Every LLM key/model below is a fallback default, applied only until the
# admin's /admin/settings > "AI & Models" panel overrides it. Overrides live
# encrypted in apps/api's database and are pulled in here on a short polling
# loop (see app/ai_config_sync.py) — no redeploy needed to rotate a key or
# switch models. These two must point at the same NestJS API instance and
# match its INTERNAL_SERVICE_SECRET exactly; this is a service-to-service
# call, not a user-facing one.
API_INTERNAL_URL=http://localhost:5005
INTERNAL_SERVICE_SECRET=

# Groq API key for LLM answers. If empty, an extractive fallback is used.
GROQ_API_KEY=
# Groq chat model used to generate answers.
GROQ_MODEL=openai/gpt-oss-120b
# Comma-separated Groq keys used for round-robin rotation (avoids 429 rate limits).
GROQ_API_KEYS=
# Gemini API key + model for document OCR/summarization.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# OpenCode Zen — free-tier OpenAI-compatible chat completions gateway, tried
# as a third fallback after Gemini and Groq both fail. Leave empty to disable.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1/chat/completions
OPENCODE_ZEN_MODEL=deepseek-v4-flash-free

# AWS Bedrock (Claude) — last resort in the fallback chain, after every free
# tier above. Authenticates with a Bedrock bearer token (AWS console →
# Bedrock → API keys), not SigV4 keys and not an Anthropic API key.
# AWS_BEARER_TOKEN_BEDROCK is read as a fallback so the AWS-standard name works.
# Needs `pip install "anthropic[bedrock]"` (already in requirements.txt).
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
# Sonnet 4.6 is not served by the Bedrock Messages endpoint; Sonnet 5 is.
# No global.*/us.* prefix here — those belong to the legacy InvokeModel API.
BEDROCK_MODEL=anthropic.claude-sonnet-5

# Fallback order. A provider left out here is never called at all.
LLM_PROVIDER_PRIORITY=gemini,groq,opencode,bedrock
# Fallback default for max concurrent LLM summarizations during a scrape run.
# The live value comes from the admin `scraping.summarizeConcurrency` setting
# (sent per-run by the API); this env var applies only when no explicit value
# is passed. Raise it if your Groq/Gemini plan allows higher throughput.
SUMMARIZE_CONCURRENCY=2
TESSERACT_LANG=nep+eng
# Max concurrent OCR jobs process-wide (uploads + scraping share this cap).
# Each job is close to 100% CPU on its own — raise cautiously on a bigger box.
OCR_MAX_CONCURRENCY=1
# Scrapes share one pooled headless browser; this caps how many crawl sessions
# use it at once. Raising it past the box's capacity is what caused the
# "[Errno 11] Resource temporarily unavailable" browser-launch failures.
SCRAPE_BROWSER_CONCURRENCY=2
# Relaunch the pooled browser after this many sessions, bounding any leak.
SCRAPE_BROWSER_MAX_SESSIONS=200
UPLOAD_DIR=./data/uploads
# The production domains (https://suchanaai.tech, https://www.suchanaai.tech)
# are always allowed in code — no need to list them here.
CORS_ORIGINS=http://localhost:3535,http://localhost:5005
